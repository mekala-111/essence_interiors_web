# SMTP used to email the studio when a form is submitted.
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=essenceinteriors2026@gmail.com
SMTP_PASS=your-gmail-app-password
# "true" for port 465 (implicit TLS); leave unset for STARTTLS on 587.
SMTP_SECURE=false

# Shown as the From address. SMTP still logs in with SMTP_USER.
MAIL_FROM=Essence Interiors <info@essenceinteriors.co.in>

# Inbox that receives Get In Touch and Book A Consultation emails.
STUDIO_EMAIL=essenceinteriors2026@gmail.com
